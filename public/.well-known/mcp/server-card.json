{
  "$schema": "https://glama.ai/schemas/mcp-server-card/v1.json",
  "name": "JassWiki MCP",
  "displayName": "JassWiki — Swiss Jass Authority",
  "description": "First publicly attested MCP knowledge server in Switzerland. AI-accessible encyclopedia for Swiss Jass: 229 articles on rules, variants, terminology, history and tactics. Authority-attested by Jassverband Schweiz (did:web:jassverband.ch) with Ed25519 cryptographic verification. Recognised as Swiss living tradition by the Federal Office of Culture (BAK).",
  "tagline": "The first authority-attested MCP server in Switzerland",
  "homepage": "https://jasswiki.ch",
  "repository": "https://github.com/remoprinz/jasswiki-mcp",
  "license": "CC-BY-SA-4.0",
  "languages": ["de", "fr", "it", "en"],
  "categories": [
    "knowledge-base",
    "documentation",
    "encyclopedia",
    "cultural-heritage",
    "search"
  ],
  "tags": [
    "swiss",
    "switzerland",
    "jass",
    "card-games",
    "cultural-heritage",
    "wikidata-anchored",
    "authority-attested",
    "did-web",
    "ed25519",
    "amcp"
  ],
  "endpoints": {
    "transport": "streamable-http",
    "http": "https://jasswiki.ch/mcp/http",
    "sse": "https://jasswiki.ch/mcp/sse",
    "messages": "https://jasswiki.ch/mcp/messages",
    "health": "https://jasswiki.ch/mcp/health",
    "manifest": "https://jasswiki.ch/.well-known/mcp.json"
  },
  "tools": [
    {
      "name": "search_jass_knowledge",
      "description": "Fuzzy-search across the official JassWiki encyclopedia (229 articles). Returns matching titles, IDs, URLs, and content excerpts.",
      "inputSchema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": {"type": "string", "description": "Search term or natural-language question"},
          "limit": {"type": "number", "default": 3, "description": "Max number of results"}
        }
      }
    },
    {
      "name": "get_term_details",
      "description": "Retrieve the full official rule or definition for a specific term ID (use after search_jass_knowledge for verification of exact wording).",
      "inputSchema": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "description": "Exact term ID (e.g. 'schieber', 'matsch', 'differenzler')"}
        }
      }
    },
    {
      "name": "show_jass_card",
      "description": "Render an official branded JassWiki knowledge card (jasswiki.ch UI) for a Swiss Jass term, rule, variant or question — with definition, category, related terms and source link.",
      "inputSchema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": {"type": "string", "description": "Swiss Jass term, rule or question to look up"}
        }
      }
    }
  ],
  "operator": {
    "name": "JassWiki",
    "url": "https://jasswiki.ch",
    "wikidataQid": "Q137900251",
    "contact": "remo@jassverband.ch"
  },
  "attestor": {
    "did": "did:web:jassverband.ch",
    "name": "Jassverband Schweiz",
    "url": "https://jassverband.ch",
    "wikidataQid": "Q139042763",
    "attestationDocument": "https://jassverband.ch/.well-known/mcp-authority.json",
    "attestationFormat": "W3C Verifiable Credential (Data Model 2.0)",
    "cryptosuite": "eddsa-jcs-2022",
    "attestationDate": "2026-05-04",
    "attestationResolution": "JVS-VS-2026-05-04-AMCP-01",
    "verificationMethod": "did:web:jassverband.ch#authority-key-1"
  },
  "trustChain": {
    "wikipediaCitation": "https://de.wikipedia.org/wiki/Jass",
    "bakRecognition": "https://www.lebendige-traditionen.ch/tradition/de/home/traditionen/jassen.html",
    "wikidataPresence": [
      "https://www.wikidata.org/wiki/Q786768",
      "https://www.wikidata.org/wiki/Q137900251",
      "https://www.wikidata.org/wiki/Q139042763"
    ]
  },
  "examples": [
    {
      "title": "Rule lookup",
      "prompt": "What are the official rules for Schieber-Jass?",
      "expectedTool": "search_jass_knowledge",
      "expectedQuery": "Schieber-Regeln"
    },
    {
      "title": "Variant comparison",
      "prompt": "Difference between Coiffeur-Schieber and Differenzler?",
      "expectedTool": "search_jass_knowledge"
    },
    {
      "title": "Tactical reference",
      "prompt": "Welche Verwerfen-Konventionen gibt es im Schieber?",
      "expectedTool": "search_jass_knowledge",
      "expectedQuery": "Verwerfen Schieber Konventionen"
    }
  ],
  "specVersion": "AMCP/0.1",
  "specArchitect": {
    "name": "Agentic Relations",
    "url": "https://agenticrelations.ch",
    "founder": "Remo Prinz",
    "specUrl": "https://agenticrelations.ch/specs/amcp"
  },
  "lastUpdated": "2026-05-04"
}
