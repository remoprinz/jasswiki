# ========================================
# DEPENDENCIES
# ========================================
# Ohne Trailing-Slash, damit auch der node_modules-SYMLINK ignoriert wird (sonst '?? node_modules').
node_modules
# iCloud-immun: echter Ordner mit .nosync-Endung (von iCloud ignoriert),
# node_modules ist ein Symlink darauf. Regel: `npm install` (nie `npm ci`, das löscht den Symlink).
node_modules.nosync/
node_modules.nosync
# Alle iCloud-immunen .nosync-Mirror generell ignorieren (z. B. public/cards.nosync)
*.nosync

# ========================================
# NEXT.JS BUILD OUTPUT
# ========================================
.next/
out/
build/

# Generierte OG-Banner (via `npm run generate:og`, deterministisch reproduzierbar).
# Manifest (src/data/og-manifest.json) bleibt getrackt — SeoHead importiert es.
/public/og/

# ========================================
# macOS iCloud-Drive-Sync-Konflikte (Pattern: "* 2/")
# Cleanup-Script: clean-icloud-dupes.sh (in Root, von prebuild aufgerufen)
# ========================================
* 2
* 2/

# ========================================
# ENVIRONMENT & SECRETS
# ========================================
.env
.env.*
*.pem
*.key
*.p12
*.jks

# ========================================
# FIREBASE
# ========================================
.firebase/
.firebaserc
firebase-debug.log
*serviceAccount*.json

# ========================================
# MISC
# ========================================
.DS_Store
*.tsbuildinfo
next-env.d.ts
.vercel
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ========================================
# BACKUP FILES
# ========================================
*.backup
*.backup-*
*.backup_*

# ========================================
# ARCHIVE (temporäre/alte Dateien)
# ========================================
.archive/

# ========================================
# EXPORTS & REPORTS (generierte Berichte)
# ========================================
exports/
validation-problems.json
safe-redirects.json

# ========================================
# FIREBASE DEBUG LOGS
# ========================================
firebase-debug*.log

# ========================================
# INTERNAL / PRIVATE (nicht öffentlich)
# ========================================

# Interne Scripts (Content-Generierung, RAG, etc.)
scripts/

# Interne Tools (RAG, Embeddings, Pinecone)
lib/

# Firebase Cloud Functions (API/MCP)
functions/

# MCP Server (separates Projekt)
mcp-server/

# Arbeits-Assets (Quelldateien, .xcf, .docx)
assets/

# Interne Dokumentation
batches/
chatgpt-gpt/
_deprecated/
backups/
jasswiki/
docs/

# TypeScript Config für interne Scripts
tsconfig.scripts.json

# IndexNow Cache (lokaler Deploy-State)
.indexnow-cache.json
