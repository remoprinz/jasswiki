{
  "name": "jasswiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "rm -rf out .next && bash clean-icloud-dupes.sh",
    "build": "npm run generate:taxonomy && npm run generate:corpus && npm run generate:llms && npm run sync:mcp && npm run sitemap && npm run validate:urls && npm run generate:og && next build",
    "postbuild": "node copy-sitemap-to-out.mjs",
    "start": "next start",
    "lint": "eslint",
    "deploy": "npm run build && firebase deploy --only hosting:jasswiki && node submit-indexnow.mjs",
    "deploy:full": "npm run build && firebase deploy && node submit-indexnow.mjs",
    "sitemap": "node generate-sitemap.mjs",
    "generate:taxonomy": "node generate-taxonomy-jsonld.mjs",
    "generate:corpus": "node generate-corpus.mjs",
    "generate:llms": "node agentic/generate-modular-llms.mjs",
    "sync:mcp": "node sync-mcp-data.mjs",
    "validate:urls": "node validate-urls.mjs",
    "generate:og": "node generate-og.mjs",
    "audit:redirects": "node audit-redirects.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.17.0",
    "lucide-react": "^0.552.0",
    "next": "^16.0.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@google/generative-ai": "^0.1.3",
    "@pinecone-database/pinecone": "^2.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "dotenv": "^16.4.5",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "opentype.js": "^2.0.0",
    "postcss": "^8.5.6",
    "sharp": "^0.35.2",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
